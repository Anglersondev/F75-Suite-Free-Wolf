<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Style TargetType="Button">
  <Setter Property="Background" Value="#29313F"/><Setter Property="Foreground" Value="#EAF0FA"/><Setter Property="BorderBrush" Value="#3B4658"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="TextBox"><Setter Property="Background" Value="#11161F"/><Setter Property="Foreground" Value="#EDF3FC"/><Setter Property="CaretBrush" Value="#89F0CE"/><Setter Property="BorderBrush" Value="#3B4658"/><Setter Property="SelectionBrush" Value="#397A6C"/></Style>
 <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#17212C"/><Setter Property="Background" Value="#DDE8EF"/><Setter Property="BorderBrush" Value="#536177"/></Style>
 <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#17212C"/><Setter Property="Background" Value="#EAF0F6"/><Setter Property="Padding" Value="8"/></Style>
 <Style TargetType="Slider"><Setter Property="Foreground" Value="#89F0CE"/></Style>
 <Style TargetType="ToolTip"><Setter Property="Background" Value="#29313F"/><Setter Property="Foreground" Value="#EEF3FB"/></Style>
</ResourceDictionary>
